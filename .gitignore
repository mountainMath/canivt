# Data files (large; download at runtime)
*.ivt
*.IVT
*.zip
# ...except the tiny bundled sample table shipped for examples/tests
!inst/extdata/*.ivt
# only ignore large data CSVs, keep package/test CSVs if any
/data-raw/*.csv

# R artefacts
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rcheck/
canivt_*.tar.gz
inst/doc
doc/
Meta/

.DS_Store

# Table exports written during development (large; regenerate with ivt_write_*)
*.parquet
/98100241.csv
/98100241_metadata/

# Knitted vignette output (source is vignettes/*.Rmd)
/vignettes/*.html
/vignettes/*.R
/vignettes/figure/

# Stray top-level figure dir from ad-hoc knitr::knit() runs (cwd = pkg root)
/figure/
# Stray top-level renders from ad-hoc plotting / hex_sticker.R runs (the real
# logo lives at man/figures/logo.png)
Rplots.pdf
/canivt.png

# session scratch (working artifacts, never committed)
scratchpad/

vignettes//figure/*.png

# range-harvest read-through cache (dev prototype)
dev/harvest-cache/
